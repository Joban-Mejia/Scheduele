# ── HorarioComún · backend ─────────────────────────────────────────────
# Copiá este archivo a `.env` y completá los valores.

# API key de Groq. OBLIGATORIA. Se usa SOLO en el backend, nunca se expone al frontend.
# Sacá una en https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modelo de visión de Groq a usar. Debe soportar entrada de imágenes.
# Verificá el modelo vigente en https://console.groq.com/docs/vision
# (al momento de escribir esto: qwen/qwen3.8-27b y qwen/qwen3.6-27b son multimodales).
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Base URL de la API de Groq (compatible con el formato OpenAI). Rara vez hay que cambiarla.
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Puerto del servidor HTTP.
PORT=3000

# Orígenes permitidos para CORS, separados por coma. Usá "*" para permitir todos (dev).
# Ej: https://tu-usuario.github.io,http://localhost:5173
CORS_ORIGINS=*

# ── Límites de subida de imágenes ──────────────────────────────────────
# Tamaño máximo de la imagen en bytes (default 8 MiB).
MAX_UPLOAD_BYTES=8388608

# ── Ciclo de vida de las salas (estado en memoria) ─────────────────────
# Horas de inactividad tras las cuales una sala se borra.
ROOM_TTL_HOURS=6
# Cada cuántos minutos corre el barrido que limpia salas vencidas.
ROOM_SWEEP_MINUTES=10

# ── Grilla de horarios libres ─────────────────────────────────────────
# Granularidad de los bloques en minutos.
GRID_GRANULARIDAD_MIN=30
# Rango horario visible (formato 24h HH:MM).
GRID_RANGO_INICIO=06:00
GRID_RANGO_FIN=22:00
# Días a considerar, separados por coma. Claves en minúsculas y sin tildes.
GRID_DIAS=lunes,martes,miercoles,jueves,viernes,sabado
